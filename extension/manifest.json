{
  "manifest_version": 3,
  "name": "视频资源下载器",
  "version": "0.16.2",
  "minimum_chrome_version": "116",
  "description": "识别当前网页的视频资源，下载直接视频文件及非加密 HLS 点播。",
  "permissions": [
    "webRequest",
    "downloads",
    "downloads.open",
    "contextMenus",
    "storage",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "视频资源下载器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media-taxonomy.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.xiaohongshu.com/*"
      ],
      "js": [
        "page-state.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
